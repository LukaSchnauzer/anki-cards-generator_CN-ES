# ============================================
# OpenAI API Configuration
# ============================================
# Requerida para la generación de texto (word_prep, sentence/pattern/audio card, guardrails)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# ElevenLabs TTS Configuration
# ============================================
# Requerida para la generación de audio (con alineación por carácter)
# Obtener en: https://elevenlabs.io/app/settings/api-keys
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# ============================================
# Anki Configuration (Opcional)
# ============================================
# AnkiConnect URL - Default: http://localhost:8765
ANKI_CONNECT_URL=http://localhost:8765

# Mazo legacy usado solo por `main.py dump` (pipeline viejo) - Default: "Chino SRS"
ANKI_DECK_NAME=Chino SRS
